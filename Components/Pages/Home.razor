@page "/"
@inject JulesApiService JulesApi
@inject AccountService AccountSvc
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Jules Panel — مدیریت پیشرفته اکانت‌ها</PageTitle>

<div class="jp-layout">

    <!-- ══════════ RIGHT SIDEBAR (Sessions) ══════════ -->
    <div class="jp-sidebar">

        <div class="jp-sidebar-head">
            <span class="jp-sidebar-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
                جلسات
            </span>
            <div class="jp-sidebar-actions">
                <button class="jp-btn-icon" title="مدیریت اکانت‌ها" @onclick="OpenAccountsDialog">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </button>
                <button class="jp-btn-icon" title="بارگذاری مجدد" @onclick="LoadSessions">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                </button>
                <button class="jp-btn-icon accent" title="جلسه جدید" @onclick="OpenCreateDialog">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
            </div>
        </div>

        <div class="jp-sessions">
            @if (_loadSess)
            {
                <div class="jp-center"><div class="jp-spinner"></div></div>
            }
            else if (_sessions.Count == 0)
            {
                <div class="jp-empty-side">هیچ جلسه‌ای یافت نشد</div>
            }
            else
            {
                <!-- Group 1: In Progress -->
                @if (WorkingSessions.Any())
                {
                    <div class="jp-group-label">
                        <span class="jp-group-dot working"></span>
                        در حال کار
                        <span class="jp-group-count">@WorkingSessions.Count()</span>
                    </div>
                    @foreach (var s in WorkingSessions)
                    {
                        <div class="jp-session-item @(s.Id == _sel?.Id ? "active" : "")" @onclick="() => Pick(s)">
                            <div class="jp-session-name">
                                @if (!string.IsNullOrEmpty(s.AccountColor))
                                {
                                    <span class="jp-account-badge" style="background:@s.AccountColor" title="@s.AccountName">@GetInitials(s.AccountName)</span>
                                }
                                @(string.IsNullOrWhiteSpace(s.Title) ? "بدون عنوان" : s.Title)
                            </div>
                            <div class="jp-session-meta">
                                <span class="jp-badge @Badge(s.State)">@(s.State ?? "—")</span>
                                <span class="jp-time">@(s.CreateTime?.ToLocalTime().ToString("MM/dd HH:mm"))</span>
                            </div>
                        </div>
                    }
                }

                <!-- Group 2: Completed -->
                @if (DoneSessions.Any())
                {
                    <div class="jp-group-label">
                        <span class="jp-group-dot done"></span>
                        کامل‌شده
                        <span class="jp-group-count">@DoneSessions.Count()</span>
                    </div>
                    @foreach (var s in DoneSessions)
                    {
                        <div class="jp-session-item @(s.Id == _sel?.Id ? "active" : "")" @onclick="() => Pick(s)">
                            <div class="jp-session-name">
                                @if (!string.IsNullOrEmpty(s.AccountColor))
                                {
                                    <span class="jp-account-badge" style="background:@s.AccountColor" title="@s.AccountName">@GetInitials(s.AccountName)</span>
                                }
                                @(string.IsNullOrWhiteSpace(s.Title) ? "بدون عنوان" : s.Title)
                            </div>
                            <div class="jp-session-meta">
                                <span class="jp-badge @Badge(s.State)">@(s.State ?? "—")</span>
                                <span class="jp-time">@(s.CreateTime?.ToLocalTime().ToString("MM/dd HH:mm"))</span>
                            </div>
                        </div>
                    }
                }

                <!-- Group 3: Archived -->
                @if (ArchivedSessions.Any())
                {
                    <div class="jp-group-label">
                        <span class="jp-group-dot archived"></span>
                        آرشیو‌شده
                        <span class="jp-group-count">@ArchivedSessions.Count()</span>
                    </div>
                    @foreach (var s in ArchivedSessions)
                    {
                        <div class="jp-session-item @(s.Id == _sel?.Id ? "active" : "")" @onclick="() => Pick(s)">
                            <div class="jp-session-name" style="opacity:.65">
                                @if (!string.IsNullOrEmpty(s.AccountColor))
                                {
                                    <span class="jp-account-badge" style="background:@s.AccountColor" title="@s.AccountName">@GetInitials(s.AccountName)</span>
                                }
                                @(string.IsNullOrWhiteSpace(s.Title) ? "بدون عنوان" : s.Title)
                            </div>
                            <div class="jp-session-meta">
                                <span class="jp-badge @Badge(s.State)">@(s.State ?? "—")</span>
                                <span class="jp-time">@(s.CreateTime?.ToLocalTime().ToString("MM/dd HH:mm"))</span>
                            </div>
                        </div>
                    }
                }

                <!-- Group 4: Other -->
                @if (OtherSessions.Any())
                {
                    <div class="jp-group-label">
                        <span class="jp-group-dot other"></span>
                        سایر
                        <span class="jp-group-count">@OtherSessions.Count()</span>
                    </div>
                    @foreach (var s in OtherSessions)
                    {
                        <div class="jp-session-item @(s.Id == _sel?.Id ? "active" : "")" @onclick="() => Pick(s)">
                            <div class="jp-session-name">
                                @if (!string.IsNullOrEmpty(s.AccountColor))
                                {
                                    <span class="jp-account-badge" style="background:@s.AccountColor" title="@s.AccountName">@GetInitials(s.AccountName)</span>
                                }
                                @(string.IsNullOrWhiteSpace(s.Title) ? "بدون عنوان" : s.Title)
                            </div>
                            <div class="jp-session-meta">
                                <span class="jp-badge @Badge(s.State)">@(s.State ?? "—")</span>
                                <span class="jp-time">@(s.CreateTime?.ToLocalTime().ToString("MM/dd HH:mm"))</span>
                            </div>
                        </div>
                    }
                }
            }
        </div>

        <!-- Sidebar Accounts Footer Stats -->
        @if (AccountSvc.GetAll().Count > 0)
        {
            <div class="jp-sidebar-footer">
                @foreach (var acc in AccountSvc.GetAll())
                {
                    var count = _sessions.Count(s => s.AccountId == acc.Id);
                    <div class="jp-account-stat-item">
                        <div class="acc-info">
                            <span class="jp-account-badge" style="background:@acc.Color">@acc.Initials</span>
                            <span>@acc.Name</span>
                        </div>
                        <span class="acc-count">@count / 100 سشن</span>
                    </div>
                }
            </div>
        }

    </div>

    <!-- ══════════ LEFT MAIN AREA ══════════ -->
    <div class="jp-main">
        @if (_sel == null)
        {
            <div class="jp-welcome">
                <div class="jp-welcome-icon">⚡</div>
                <h2>پنل مدیریت هوشمند Jules</h2>
                <p>یک جلسه از سایدبار سمت راست انتخاب کنید یا یک جلسه جدید بسازید.</p>
                <div style="display:flex; gap:12px;">
                    <button class="jp-btn-primary" @onclick="OpenCreateDialog">+ جلسه جدید</button>
                    <button class="jp-btn-secondary" @onclick="OpenAccountsDialog">👤 مدیریت اکانت‌ها</button>
                </div>
            </div>
        }
        else
        {
            <!-- TITLEBAR -->
            <div class="jp-titlebar">
                <div class="jp-titlebar-left">
                    @if (!string.IsNullOrEmpty(_sel.AccountColor))
                    {
                        <span class="jp-account-badge" style="background:@_sel.AccountColor; width:22px; height:22px; font-size:.72rem;" title="@_sel.AccountName">@GetInitials(_sel.AccountName)</span>
                    }
                    <span class="jp-session-title-text">@(string.IsNullOrWhiteSpace(_sel.Title) ? _sel.Id : _sel.Title)</span>
                    <span class="jp-badge @Badge(_sel.State)">@(_sel.State ?? "—")</span>
                </div>
                <div class="jp-titlebar-actions">
                    @if (_sel.NeedsPlanApproval)
                    {
                        <button class="jp-btn-approve-small" @onclick="Approve">⚡ تأیید برنامه اجرا</button>
                    }
                    <button class="jp-btn-icon" title="بروزرسانی" @onclick="Refresh">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                    </button>
                </div>
            </div>

            <!-- TAB STRIP -->
            <div class="jp-tabstrip">
                <button class="jp-tab @_tabClass(0)" @onclick="() => _tab = 0">
                    📄 خروجی و فعالیت‌ها
                    @if (_activities.Count > 0)
                    {
                        <span class="jp-tab-count">@_activities.Count</span>
                    }
                </button>
                <button class="jp-tab @_tabClass(1)" @onclick="() => _tab = 1">
                    📋 برنامه اجرا (Plan)
                    @if (_plan?.Steps.Count > 0)
                    {
                        <span class="jp-tab-count">@_plan.Steps.Count</span>
                    }
                </button>
            </div>

            <!-- TAB BODY -->
            <div class="jp-content">

                <!-- TAB 0: Activities -->
                @if (_tab == 0)
                {
                    if (_loadAct)
                    {
                        <div class="jp-center"><div class="jp-spinner"></div><span style="font-size:.85rem;">در حال دریافت فعالیت‌ها...</span></div>
                    }
                    else if (_activities.Count == 0)
                    {
                        <div class="jp-empty">هنوز هیچ فعالیتی برای این جلسه ثبت نشده است.</div>
                    }
                    else
                    {
                        <div class="jp-activities">
                            @foreach (var act in _activities)
                            {
                                @if (act.HasContent)
                                {
                                    <div class="jp-activity @(act.IsAgent ? "jp-activity-agent" : "jp-activity-user")">
                                        <div class="jp-act-head">
                                            <span class="jp-activity-who @(act.IsAgent ? "agent" : "user")">
                                                @(act.IsAgent ? "🤖 Jules Agent" : "👤 شما")
                                            </span>
                                            <span class="jp-act-time">@(act.CreateTime?.ToLocalTime().ToString("HH:mm:ss"))</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(act.Text))
                                        {
                                            <div class="jp-activity-body">@act.Text</div>
                                        }
                                        @if (act.Plan != null)
                                        {
                                            <div class="jp-activity-body plan-ref">
                                                📌 برنامه جدید پیشنهاد شد: <strong>@act.Plan.Title</strong> (@act.Plan.Steps.Count گام)
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                }

                <!-- TAB 1: Plan -->
                @if (_tab == 1)
                {
                    if (_plan == null)
                    {
                        <div class="jp-empty">برنامه‌ای برای این جلسه ثبت نشده است.</div>
                    }
                    else
                    {
                        <div style="padding:16px;">
                            @if (!string.IsNullOrWhiteSpace(_plan.Title))
                            {
                                <h3 style="font-size:1.05rem; font-weight:700; margin-bottom:6px; color:var(--c-accent);">@_plan.Title</h3>
                            }
                            @if (!string.IsNullOrWhiteSpace(_plan.Description))
                            {
                                <p style="font-size:.85rem; color:var(--c-muted); margin-bottom:16px;">@_plan.Description</p>
                            }

                            @if (_sel.NeedsPlanApproval)
                            {
                                <div class="jp-approve-banner">
                                    <span>⚠️ برنامه منتظر تأیید شماست تا مراحل اجرا شروع شود.</span>
                                    <button class="jp-btn-approve" @onclick="Approve">تأیید و اجرای برنامه</button>
                                </div>
                            }

                            <div class="jp-plan-steps">
                                @for (int i = 0; i < _plan.Steps.Count; i++)
                                {
                                    var st = _plan.Steps[i];
                                    <div class="jp-step">
                                        <div class="jp-step-num">@(i + 1)</div>
                                        <div class="jp-step-content">
                                            <div class="jp-step-title">@st.Title</div>
                                            @if (!string.IsNullOrWhiteSpace(st.Description))
                                            {
                                                <div class="jp-step-desc">@st.Description</div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(st.State))
                                        {
                                            <span class="jp-badge @Badge(st.State)">@st.State</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

            </div>

            <!-- PROMPT INPUT BAR -->
            <div class="jp-inputbar">
                <textarea class="jp-textarea"
                          rows="2"
                          placeholder="دستور جدید برای Jules ارسال کنید... (Ctrl+Enter برای ارسال)"
                          @bind="_prompt"
                          @bind:event="oninput"
                          @onkeydown="OnPromptKeyDown"></textarea>
                <button class="jp-btn-send" disabled="@_sending" @onclick="Send">
                    @if (_sending)
                    {
                        <div class="jp-spinner sm"></div>
                    }
                    else
                    {
                        <span>ارسال</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    }
                </button>
            </div>
        }
    </div>

</div>

<!-- ══════════ CREATE SESSION DIALOG ══════════ -->
@if (_dlgOpen)
{
    <div class="jp-backdrop" @onclick="() => _dlgOpen = false">
        <div class="jp-dialog" @onclick:stopPropagation>
            <div class="jp-dialog-head">
                <span class="jp-dialog-title">✨ ایجاد جلسه جدید</span>
                <button class="jp-btn-close" @onclick="() => _dlgOpen = false">✕</button>
            </div>

            <div class="jp-dialog-body">

                <!-- Account Selector -->
                @if (AccountSvc.GetAll().Count > 0)
                {
                    <div class="jp-field">
                        <label>انتخاب اکانت:</label>
                        <select @bind="_nAccountId">
                            @foreach (var acc in AccountSvc.GetAll())
                            {
                                <option value="@acc.Id">👤 @acc.Name (@acc.Email)</option>
                            }
                        </select>
                    </div>
                }

                <div class="jp-field">
                    <label>عنوان جلسه (اختیاری):</label>
                    <input type="text" placeholder="مثلاً: افزودن فرم لاگین" @bind="_nTitle" />
                </div>

                <div class="jp-field">
                    <label>دستور اولیه (Prompt):</label>
                    <textarea rows="4" placeholder="توضیح دهید Jules چه کاری باید انجام دهد..." @bind="_nPrompt"></textarea>
                </div>

                <div class="jp-field">
                    <label>منبع کد (GitHub Repo):</label>
                    @if (_loadSources)
                    {
                        <div class="jp-center" style="padding:10px;"><div class="jp-spinner sm"></div>در حال دریافت مخازن...</div>
                    }
                    else
                    {
                        <select @bind="_nSource" @bind:after="OnSourceChanged">
                            <option value="">-- بدون منبع --</option>
                            @foreach (var s in _sources)
                            {
                                <option value="@s.Name">@s.DisplayName</option>
                            }
                        </select>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_nSource))
                {
                    var curSrc = _sources.FirstOrDefault(s => s.Name == _nSource);
                    <div class="jp-field">
                        <label>شاخه (Branch):</label>
                        <select @bind="_nBranch">
                            @if (curSrc?.GithubRepo?.Branches.Count > 0)
                            {
                                @foreach (var b in curSrc.GithubRepo.Branches)
                                {
                                    <option value="@b.DisplayName">@b.DisplayName</option>
                                }
                            }
                            else
                            {
                                <option value="main">main</option>
                                <option value="master">master</option>
                            }
                        </select>
                    </div>
                }

                <div class="jp-field-check">
                    <input type="checkbox" id="chkPlan" @bind="_nApproval" />
                    <label for="chkPlan">نیاز به تأیید برنامه اجرا قبل از شروع کار داشته باشد</label>
                </div>

            </div>

            <div class="jp-dialog-foot">
                <button class="jp-btn-secondary" @onclick="() => _dlgOpen = false">انصراف</button>
                <button class="jp-btn-primary" disabled="@(_creating || string.IsNullOrWhiteSpace(_nPrompt))" @onclick="Create">
                    @if (_creating) { <div class="jp-spinner sm"></div> }
                    else { <span>ایجاد جلسه</span> }
                </button>
            </div>
        </div>
    </div>
}

<!-- ══════════ ACCOUNTS MANAGEMENT DIALOG ══════════ -->
@if (_accDlgOpen)
{
    <div class="jp-backdrop" @onclick="() => _accDlgOpen = false">
        <div class="jp-dialog" style="max-width:560px;" @onclick:stopPropagation>
            <div class="jp-dialog-head">
                <span class="jp-dialog-title">👤 مدیریت اکانت‌های Jules</span>
                <button class="jp-btn-close" @onclick="() => _accDlgOpen = false">✕</button>
            </div>

            <div class="jp-dialog-body">

                <!-- List of Accounts -->
                <div style="margin-bottom:20px;">
                    <div style="font-weight:700; font-size:.85rem; color:var(--c-muted); margin-bottom:10px;">اکانت‌های فعال:</div>
                    @if (AccountSvc.GetAll().Count == 0)
                    {
                        <div class="jp-empty" style="padding:16px;">هیچ اکانتی اضافه نشده است. (از کلید پیش‌فرض استفاده می‌شود)</div>
                    }
                    else
                    {
                        @foreach (var acc in AccountSvc.GetAll())
                        {
                            var sessCount = _sessions.Count(s => s.AccountId == acc.Id);
                            <div class="jp-acc-card">
                                <div class="jp-acc-left">
                                    <div class="jp-acc-avatar-lg" style="background:@acc.Color">@acc.Initials</div>
                                    <div>
                                        <div class="jp-acc-name">@acc.Name</div>
                                        <div class="jp-acc-email">@acc.Email • @sessCount سشن فعال</div>
                                    </div>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <button class="jp-btn-icon" title="ویرایش" @onclick="() => EditAccount(acc)">✏️</button>
                                    <button class="jp-btn-icon" title="حذف" @onclick="() => DeleteAccount(acc.Id)">🗑️</button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Add/Edit Account Form -->
                <div style="border-top:1px solid var(--c-border); padding-top:14px;">
                    <div style="font-weight:700; font-size:.85rem; color:var(--c-accent); margin-bottom:12px;">
                        @(_editAccId == null ? "➕ افزودن اکانت جدید" : "✏️ ویرایش اکانت")
                    </div>

                    <div class="jp-field">
                        <label>نام اکانت / صاحب حساب:</label>
                        <input type="text" placeholder="مثلاً: اکانت شرکت 1" @bind="_accName" />
                    </div>

                    <div class="jp-field">
                        <label>ایمیل اکانت:</label>
                        <input type="email" placeholder="user@gmail.com" @bind="_accEmail" />
                    </div>

                    <div class="jp-field">
                        <label>Jules API Key:</label>
                        <input type="password" placeholder="AIzaSy..." @bind="_accApiKey" />
                    </div>

                    <div class="jp-field">
                        <label>رنگ آواتار:</label>
                        <div class="jp-color-dots">
                            @foreach (var color in AvailableColors)
                            {
                                <div class="jp-color-dot @(color == _accColor ? "active" : "")"
                                     style="background:@color"
                                     @onclick="() => _accColor = color"></div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <div class="jp-dialog-foot">
                @if (_editAccId != null)
                {
                    <button class="jp-btn-secondary" @onclick="ResetAccForm">انصراف از ویرایش</button>
                }
                <button class="jp-btn-primary" disabled="@(string.IsNullOrWhiteSpace(_accName) || string.IsNullOrWhiteSpace(_accApiKey))" @onclick="SaveAccount">
                    ذخیره اکانت
                </button>
            </div>
        </div>
    </div>
}

@code {
    List<Session> _sessions = new();
    Session? _sel;
    List<Activity> _activities = new();
    Plan? _plan;
    List<JulesSource> _sources = new();

    bool _loadSess, _loadAct, _sending, _creating, _loadSources;
    int _tab = 0;
    string _prompt = "";

    // Create session dialog
    bool _dlgOpen;
    string _nTitle = "", _nPrompt = "", _nSource = "", _nBranch = "main", _nAccountId = "";
    bool _nApproval = true;

    // Accounts management dialog
    bool _accDlgOpen;
    string? _editAccId;
    string _accName = "", _accEmail = "", _accApiKey = "", _accColor = "#a78bfa";
    static readonly string[] AvailableColors = new[] { "#a78bfa", "#60a5fa", "#34d399", "#fbbf24", "#f87171", "#ec4899", "#8b5cf6" };

    System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
        _timer = new System.Threading.Timer(async _ =>
        {
            if (_sel?.IsWorking == true || _sel?.NeedsPlanApproval == true)
                await InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
        }, null, 8000, 8000);
    }

    async Task LoadSessions()
    {
        _loadSess = true; StateHasChanged();
        var accounts = AccountSvc.GetAll();
        var combined = new List<Session>();

        if (accounts.Count > 0)
        {
            foreach (var acc in accounts)
            {
                var list = await JulesApi.ListSessionsAsync(acc.ApiKey);
                foreach (var s in list)
                {
                    s.AccountId = acc.Id;
                    s.AccountName = acc.Name;
                    s.AccountColor = acc.Color;
                    combined.Add(s);
                }
            }
        }
        else
        {
            // Fallback to default config API key
            var list = await JulesApi.ListSessionsAsync();
            combined.AddRange(list);
        }

        _sessions = combined.OrderByDescending(s => s.CreateTime).ToList();
        if (_sel != null) _sel = _sessions.FirstOrDefault(s => s.Id == _sel.Id) ?? _sel;
        _loadSess = false; StateHasChanged();
    }

    async Task Pick(Session s)
    {
        _sel = s; _tab = 0; _activities = new(); _plan = null;
        StateHasChanged();
        await LoadAct();
    }

    string? GetSelectedApiKey()
    {
        if (_sel?.AccountId != null)
        {
            return AccountSvc.GetById(_sel.AccountId)?.ApiKey;
        }
        return null;
    }

    async Task Refresh()
    {
        if (_sel == null) return;
        var key = GetSelectedApiKey();
        var u = await JulesApi.GetSessionAsync(_sel.Name, key);
        if (u != null)
        {
            u.AccountId = _sel.AccountId;
            u.AccountName = _sel.AccountName;
            u.AccountColor = _sel.AccountColor;
            _sel = u;
            var i = _sessions.FindIndex(x => x.Id == u.Id);
            if (i >= 0) _sessions[i] = u;
        }
        await LoadAct();
    }

    async Task LoadAct()
    {
        if (_sel == null) return;
        _loadAct = true; StateHasChanged();
        var key = GetSelectedApiKey();
        _activities = await JulesApi.ListActivitiesAsync(_sel.Name, key);
        _plan = _activities.LastOrDefault(a => a.Plan != null)?.Plan;
        _loadAct = false; StateHasChanged();
    }

    async Task OnPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey) await Send();
    }

    async Task Send()
    {
        if (_sel == null || string.IsNullOrWhiteSpace(_prompt)) return;
        _sending = true; StateHasChanged();
        var key = GetSelectedApiKey();
        if (await JulesApi.SendMessageAsync(_sel.Name, _prompt, key))
        {
            Snackbar.Add("پیام ارسال شد", Severity.Success);
            _prompt = "";
            await Refresh();
        }
        else Snackbar.Add("خطا در ارسال", Severity.Error);
        _sending = false; StateHasChanged();
    }

    async Task Approve()
    {
        if (_sel == null) return;
        var key = GetSelectedApiKey();
        if (await JulesApi.ApprovePlanAsync(_sel.Name, key))
        { Snackbar.Add("برنامه تأیید شد", Severity.Success); await Refresh(); }
        else Snackbar.Add("خطا در تأیید", Severity.Error);
    }

    async Task OpenCreateDialog()
    {
        _nTitle = ""; _nPrompt = ""; _nSource = ""; _nBranch = "main"; _nApproval = true;
        var accs = AccountSvc.GetAll();
        if (accs.Count > 0) _nAccountId = accs[0].Id;

        var key = !string.IsNullOrEmpty(_nAccountId) ? AccountSvc.GetById(_nAccountId)?.ApiKey : null;

        _loadSources = true;
        _dlgOpen = true;
        StateHasChanged();
        _sources = await JulesApi.ListSourcesAsync(key);
        _loadSources = false;
        StateHasChanged();
    }

    void OnSourceChanged()
    {
        var src = _sources.FirstOrDefault(s => s.Name == _nSource);
        _nBranch = src?.GithubRepo?.DefaultBranchName ?? "main";
    }

    async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_nPrompt)) return;
        _creating = true; StateHasChanged();

        var key = !string.IsNullOrEmpty(_nAccountId) ? AccountSvc.GetById(_nAccountId)?.ApiKey : null;

        var req = new CreateSessionRequest
        {
            Prompt = _nPrompt,
            Title = string.IsNullOrWhiteSpace(_nTitle) ? null : _nTitle,
            RequirePlanApproval = _nApproval
        };
        if (!string.IsNullOrEmpty(_nSource))
            req.SourceContext = new SourceContext
            {
                Source = _nSource,
                GithubRepoContext = new GithubRepoContext { StartingBranch = _nBranch }
            };

        var s = await JulesApi.CreateSessionAsync(req, key);
        _creating = false;
        if (s != null)
        {
            Snackbar.Add("جلسه ایجاد شد", Severity.Success);
            _dlgOpen = false;
            await LoadSessions();
            var found = _sessions.FirstOrDefault(x => x.Id == s.Id);
            if (found != null) await Pick(found);
        }
        else Snackbar.Add("خطا در ایجاد جلسه", Severity.Error);
        StateHasChanged();
    }

    // ── Accounts Dialog logic ──────────────────────────────────────────────────

    void OpenAccountsDialog()
    {
        ResetAccForm();
        _accDlgOpen = true;
    }

    void ResetAccForm()
    {
        _editAccId = null;
        _accName = "";
        _accEmail = "";
        _accApiKey = "";
        _accColor = AvailableColors[0];
    }

    void EditAccount(AccountProfile acc)
    {
        _editAccId = acc.Id;
        _accName = acc.Name;
        _accEmail = acc.Email;
        _accApiKey = acc.ApiKey;
        _accColor = acc.Color;
    }

    async Task SaveAccount()
    {
        if (string.IsNullOrWhiteSpace(_accName) || string.IsNullOrWhiteSpace(_accApiKey)) return;

        if (_editAccId == null)
        {
            await AccountSvc.AddAsync(new AccountProfile
            {
                Name = _accName,
                Email = _accEmail,
                ApiKey = _accApiKey,
                Color = _accColor
            });
            Snackbar.Add("اکانت جدید اضافه شد", Severity.Success);
        }
        else
        {
            await AccountSvc.UpdateAsync(new AccountProfile
            {
                Id = _editAccId,
                Name = _accName,
                Email = _accEmail,
                ApiKey = _accApiKey,
                Color = _accColor
            });
            Snackbar.Add("اطلاعات اکانت بروزرسانی شد", Severity.Success);
        }

        ResetAccForm();
        await LoadSessions();
    }

    async Task DeleteAccount(string id)
    {
        if (await AccountSvc.DeleteAsync(id))
        {
            Snackbar.Add("اکانت حذف شد", Severity.Info);
            await LoadSessions();
        }
    }

    string GetInitials(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();

    // ── Computed session groups
    IEnumerable<Session> WorkingSessions  => _sessions.Where(s => IsWorking(s.State));
    IEnumerable<Session> DoneSessions     => _sessions.Where(s => IsDone(s.State));
    IEnumerable<Session> ArchivedSessions => _sessions.Where(s => IsArchived(s.State));
    IEnumerable<Session> OtherSessions    => _sessions.Where(s => !IsWorking(s.State) && !IsDone(s.State) && !IsArchived(s.State));

    // ── Session state helpers
    bool IsWorking(string? st)
    {
        if (st == null) return false;
        var u = st.ToUpper();
        return u.Contains("WORKING") || u.Contains("RUNNING") || (u.Contains("PLAN") && u.Contains("WAIT"));
    }
    bool IsDone(string? st)
    {
        if (st == null) return false;
        var u = st.ToUpper();
        return u.Contains("DONE") || u.Contains("COMPLETED") || u.Contains("FINISHED");
    }
    bool IsArchived(string? st)
    {
        if (st == null) return false;
        return st.ToUpper().Contains("ARCHIVED");
    }

    string Badge(string? st)
    {
        if (st == null) return "badge-idle";
        var u = st.ToUpper();
        if (IsWorking(st)) return "badge-working";
        if (IsDone(st))    return "badge-done";
        if (IsArchived(st)) return "badge-archived";
        if (u.Contains("ERROR") || u.Contains("FAIL")) return "badge-error";
        return "badge-idle";
    }

    string _tabClass(int idx) => _tab == idx ? "active" : "";

    public void Dispose() => _timer?.Dispose();
}

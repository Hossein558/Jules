}

<!-- ══════════ CREATE SESSION DIALOG ══════════ -->
@if (_dlgOpen)
{
    <div class="jp-backdrop" @onclick="() => _dlgOpen = false">
        <div class="jp-modal" @onclick:stopPropagation>
            <div class="jp-modal-head">
                <span class="jp-modal-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    ایجاد جلسه جدید Jules
                </span>
                <button class="jp-modal-close" @onclick="() => _dlgOpen = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="jp-modal-body">

                @if (AccountSvc.GetAll().Count > 0)
                {
                    <div class="jp-form-field">
                        <label class="jp-form-label">حساب کاربری</label>
                        <select class="jp-form-select" @bind="_nAccountId">
                            @foreach (var acc in AccountSvc.GetAll())
                            {
                                <option value="@acc.Id">@acc.Name — @acc.Email</option>
                            }
                        </select>
                    </div>
                }

                <div class="jp-form-field">
                    <label class="jp-form-label">عنوان <span class="jp-form-optional">(اختیاری)</span></label>
                    <input class="jp-form-input" type="text" placeholder="مثلاً: اصلاح استایل‌های برد کانبان" @bind="_nTitle" />
                </div>

                <div class="jp-form-field">
                    <label class="jp-form-label">دستور اصلی (Prompt) <span class="jp-form-req">*</span></label>
                    <textarea class="jp-form-textarea" rows="4" placeholder="به Jules بگویید دقیقاً چه کاری باید در کدها انجام دهد..." @bind="_nPrompt"></textarea>
                </div>

                <div class="jp-form-field">
                    <label class="jp-form-label">مخزن GitHub</label>
                    @if (_loadSources)
                    {
                        <div class="jp-state-center" style="padding:10px"><div class="jp-spin jp-spin--sm"></div><span class="jp-state-label">دریافت مخازن...</span></div>
                    }
                    else
                    {
                        <select class="jp-form-select" @bind="_nSource" @bind:after="OnSourceChanged">
                            <option value="">— بدون مخزن متصل —</option>
                            @foreach (var src in _sources)
                            {
                                <option value="@src.Name">@src.DisplayName</option>
                            }
                        </select>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_nSource))
                {
                    var curSrc = _sources.FirstOrDefault(s => s.Name == _nSource);
                    <div class="jp-form-field">
                        <label class="jp-form-label">شاخه هدف (Branch)</label>
                        <select class="jp-form-select" @bind="_nBranch">
                            @if (curSrc?.GithubRepo?.Branches.Count > 0)
                            {
                                @foreach (var b in curSrc.GithubRepo.Branches)
                                {
                                    <option value="@b.DisplayName">@b.DisplayName</option>
                                }
                            }
                            else
                            {
                                <option value="main">main</option>
                                <option value="master">master</option>
                            }
                        </select>
                    </div>
                }

                <div class="jp-form-check">
                    <input type="checkbox" id="chkApproval" @bind="_nApproval" />
                    <label for="chkApproval">تأیید برنامه اجرا (Plan Approval) قبل از شروع خودکار کار</label>
                </div>

            </div>
            <div class="jp-modal-foot">
                <button class="jp-btn jp-btn--ghost" @onclick="() => _dlgOpen = false">انصراف</button>
                <button class="jp-btn jp-btn--primary" disabled="@(_creating || string.IsNullOrWhiteSpace(_nPrompt))" @onclick="Create">
                    @if (_creating) { <div class="jp-spin jp-spin--sm"></div> } else { <span>ایجاد و شروع جلسه</span> }
                </button>
            </div>
        </div>
    </div>
}

<!-- ══════════ ACCOUNTS DIALOG ══════════ -->
@if (_accDlgOpen)
{
    <div class="jp-backdrop" @onclick="() => _accDlgOpen = false">
        <div class="jp-modal jp-modal--wide" @onclick:stopPropagation>
            <div class="jp-modal-head">
                <span class="jp-modal-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    مدیریت اکانت‌های Jules
                </span>
                <button class="jp-modal-close" @onclick="() => _accDlgOpen = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="jp-modal-body">

                <!-- Existing Accounts -->
                <div class="jp-section-label">اکانت‌های فعال</div>
                @if (!AccountSvc.GetAll().Any())
                {
                    <div class="jp-empty-state" style="padding:14px 0">هیچ اکانتی اضافه نشده. از کلید پیش‌فرض استفاده می‌شود.</div>

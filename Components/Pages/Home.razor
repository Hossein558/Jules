                </div>

            </div>
            <div class="jp-modal-foot">
                @if (_editAccId != null)
                {
                    <button class="jp-btn jp-btn--ghost" @onclick="ResetAccForm">انصراف از ویرایش</button>
                }
                <button class="jp-btn jp-btn--primary"
                        disabled="@(string.IsNullOrWhiteSpace(_accName) || string.IsNullOrWhiteSpace(_accApiKey))"
                        @onclick="SaveAccount">
                    ذخیره اکانت
                </button>
            </div>
        </div>
    </div>
}

@code {
    List<Session> _sessions = new();
    Session? _sel;
    List<Activity> _activities = new();
    Plan? _plan;
    List<JulesSource> _sources = new();

    bool _loadSess, _loadAct, _sending, _creating, _loadSources;
    int _tab = 0;
    string _prompt = "";

    bool _dlgOpen;
    bool _deleteDlgOpen;
    bool _deleting;
    string _nTitle = "", _nPrompt = "", _nSource = "", _nBranch = "main", _nAccountId = "";
    bool _nApproval = true;

    bool _accDlgOpen;
    string? _editAccId;
    string _accName = "", _accEmail = "", _accApiKey = "", _accColor = "#a78bfa";

    string _searchQuery = "";
    string _filterAccountId = "";

    static readonly string[] AvailableColors =
        { "#a78bfa", "#60a5fa", "#34d399", "#fbbf24", "#f87171", "#ec4899", "#8b5cf6" };

    System.Threading.Timer? _timer;
    bool _disposed;
    bool _isLightMode = true;
    MainViewMode _mainViewMode = MainViewMode.Kanban;
    KanbanViewMode _kanbanMode = KanbanViewMode.Status;

    enum MainViewMode
    {
        List,
        Kanban
    }

    enum KanbanViewMode
    {
        Status,
        AccountSwimlanes,
        SimpleCards
    }

    // Filtered Sessions based on search query and account filter
    IEnumerable<Session> FilteredSessions
    {
        get
        {
            var res = _sessions.AsEnumerable();
            if (!string.IsNullOrEmpty(_filterAccountId))
                res = res.Where(s => s.AccountId == _filterAccountId);

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim();
                res = res.Where(s =>
                    (s.Title != null && s.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (s.Prompt != null && s.Prompt.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (s.RepositoryDisplay.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (s.AccountName != null && s.AccountName.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (s.Id.Contains(q, StringComparison.OrdinalIgnoreCase)));
            }
            return res;
        }
    }

    IEnumerable<AccountProfile> ActiveAccountsInView
    {
        get
        {
            var accs = AccountSvc.GetAll();
            if (!string.IsNullOrEmpty(_filterAccountId))
                return accs.Where(a => a.Id == _filterAccountId);
            return accs;
        }
    }

    void ClearFilters()
    {
        _searchQuery = "";
        _filterAccountId = "";
    }

    void SetMainView(MainViewMode mode)
    {
        _mainViewMode = mode;
        StateHasChanged();
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
        _timer = new System.Threading.Timer(async _ =>
        {
            try
            {
                if (_disposed) return;
                if (_sel?.IsWorking == true || _sel?.NeedsPlanApproval == true)
                {
                    await InvokeAsync(async () =>
                    {
                        if (_disposed) return;
                        await Refresh();
                        StateHasChanged();
                    });
                }
            }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { Console.WriteLine($"Poll error: {ex.Message}"); }
        }, null, 8000, 8000);
    }

    async Task ToggleTheme()
    {
        _isLightMode = !_isLightMode;
        if (_isLightMode)
        {
            await JS.InvokeVoidAsync("document.body.classList.add", "light-theme");
        }
        else
        {
            await JS.InvokeVoidAsync("document.body.classList.remove", "light-theme");
        }
    }

    public void Dispose() { _disposed = true; _timer?.Dispose(); }

    void OpenDeleteConfirm()
    {
        _deleteDlgOpen = true;
    }

    async Task ConfirmDeleteSession()
    {
        if (_sel == null || _deleting) return;
        _deleting = true;
        StateHasChanged();

        try
        {
            var apiKey = SelectedApiKey();
            var success = await JulesApi.DeleteSessionAsync(_sel.Id, apiKey);
            if (success)
            {
                Snackbar.Add("جلسه با موفقیت حذف شد", Severity.Success);
                var deletedId = _sel.Id;
                _sel = null;
                _deleteDlgOpen = false;
                _sessions.RemoveAll(s => s.Id == deletedId);
                await LoadSessions();
            }
            else
            {
                Snackbar.Add("خطا در حذف جلسه", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا: {ex.Message}", Severity.Error);
        }
        finally
        {
            _deleting = false;
            _deleteDlgOpen = false;
            StateHasChanged();
        }
    }

    // ── Data Loading ──────────────────────────────────────────────────────────

    async Task LoadSessions()
    {
        _loadSess = true; StateHasChanged();
        try
        {
            _sessions = await FetchAllSessionsAsync();
            if (_sel != null) _sel = _sessions.FirstOrDefault(s => s.Id == _sel.Id) ?? _sel;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadSessions: {ex.Message}");
            Snackbar.Add("خطا در بارگذاری جلسات", Severity.Error);
        }
        finally { _loadSess = false; StateHasChanged(); }
    }

    async Task<List<Session>> FetchAllSessionsAsync()
    {
        var accounts = AccountSvc.GetAll();
        var combined = new List<Session>();

        if (accounts.Count > 0)
        {
            var tasks = accounts.Select(async acc =>
            {
                try
                {
                    var list = await JulesApi.ListSessionsAsync(acc.ApiKey);
                    foreach (var s in list)
                    {
                        s.AccountId    = acc.Id;
                        s.AccountName  = acc.Name;
                        s.AccountColor = acc.Color;
                    }
                    return list;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Fetch sessions [{acc.Name}]: {ex.Message}");
                    return new List<Session>();
                }
            }).ToList();

            foreach (var list in await Task.WhenAll(tasks))
                combined.AddRange(list);
        }
        else
        {
            combined.AddRange(await JulesApi.ListSessionsAsync());
        }

        return combined.OrderByDescending(s => s.CreateTime).ToList();
    }

    async Task Pick(Session s)
    {
        _sel = s; _tab = 0; _activities = new(); _plan = null;
        _mainViewMode = MainViewMode.List;
        StateHasChanged();
        await LoadAct();
    }

    string? SelectedApiKey()
    {
        if (_sel?.AccountId == null) return null;
        return AccountSvc.GetById(_sel.AccountId)?.ApiKey;
    }

    async Task Refresh()
    {
        if (_sel == null) return;
        var u = await JulesApi.GetSessionAsync(_sel.Name, SelectedApiKey());
        if (u != null)
        {
            u.AccountId = _sel.AccountId; u.AccountName = _sel.AccountName; u.AccountColor = _sel.AccountColor;
            _sel = u;
            var i = _sessions.FindIndex(x => x.Id == u.Id);
            if (i >= 0) _sessions[i] = u;
        }
        await LoadAct();
    }

    async Task LoadAct()
    {
        if (_sel == null) return;
        _loadAct = true; StateHasChanged();
        _activities = await JulesApi.ListActivitiesAsync(_sel.Name, SelectedApiKey());
        _plan = _activities.LastOrDefault(a => a.Plan != null)?.Plan;
        _loadAct = false; StateHasChanged();
    }

    // ── User Actions ──────────────────────────────────────────────────────────

    async Task OnPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey) await Send();
    }

    async Task Send()
    {
        if (_sel == null || string.IsNullOrWhiteSpace(_prompt)) return;
        _sending = true; StateHasChanged();
        if (await JulesApi.SendMessageAsync(_sel.Name, _prompt, SelectedApiKey()))
        {
            Snackbar.Add("پیام ارسال شد", Severity.Success);
            _prompt = "";
            await Refresh();
        }
        else Snackbar.Add("خطا در ارسال", Severity.Error);
        _sending = false; StateHasChanged();
    }

    async Task Approve()
    {
        if (_sel == null) return;
        if (await JulesApi.ApprovePlanAsync(_sel.Name, SelectedApiKey()))
        { Snackbar.Add("برنامه تأیید شد", Severity.Success); await Refresh(); }
        else Snackbar.Add("خطا در تأیید", Severity.Error);
    }

    async Task ApproveSessionDirect(Session s)
    {
        var key = !string.IsNullOrEmpty(s.AccountId) ? AccountSvc.GetById(s.AccountId)?.ApiKey : null;
        if (await JulesApi.ApprovePlanAsync(s.Name, key))
        {
            Snackbar.Add($"برنامه جلسه '{s.DisplayTitle}' تأیید شد", Severity.Success);
            await LoadSessions();
        }
        else
        {
            Snackbar.Add("خطا در تأیید برنامه", Severity.Error);
        }
    }

    // ── Create Session ────────────────────────────────────────────────────────

    async Task OpenCreateDialog()
    {
        _nTitle = ""; _nPrompt = ""; _nSource = ""; _nBranch = "main"; _nApproval = true;
        var accs = AccountSvc.GetAll();
        _nAccountId = accs.Count > 0 ? accs[0].Id : "";

        var key = !string.IsNullOrEmpty(_nAccountId) ? AccountSvc.GetById(_nAccountId)?.ApiKey : null;
        _loadSources = true; _dlgOpen = true; StateHasChanged();
        _sources = await JulesApi.ListSourcesAsync(key);
        _loadSources = false; StateHasChanged();
    }

    void OnSourceChanged()
    {
        var src = _sources.FirstOrDefault(s => s.Name == _nSource);
        _nBranch = src?.GithubRepo?.DefaultBranchName ?? "main";
    }

    async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_nPrompt)) return;
        _creating = true; StateHasChanged();
        var key = !string.IsNullOrEmpty(_nAccountId) ? AccountSvc.GetById(_nAccountId)?.ApiKey : null;
        var req = new CreateSessionRequest
        {
            Prompt = _nPrompt,
            Title = string.IsNullOrWhiteSpace(_nTitle) ? null : _nTitle,
            RequirePlanApproval = _nApproval
        };
        if (!string.IsNullOrEmpty(_nSource))
            req.SourceContext = new SourceContext
            {
                Source = _nSource,
                GithubRepoContext = new GithubRepoContext { StartingBranch = _nBranch }
            };

        var s = await JulesApi.CreateSessionAsync(req, key);
        _creating = false;
        if (s != null)
        {
            if (!string.IsNullOrEmpty(_nAccountId))
            {
                var acc = AccountSvc.GetById(_nAccountId);
                if (acc != null) { s.AccountId = acc.Id; s.AccountName = acc.Name; s.AccountColor = acc.Color; }
            }
            Snackbar.Add("جلسه ایجاد شد", Severity.Success);
            _dlgOpen = false;
            await LoadSessions();
            var found = _sessions.FirstOrDefault(x => x.Id == s.Id);
            if (found != null) await Pick(found);
        }
        else Snackbar.Add("خطا در ایجاد جلسه", Severity.Error);
        StateHasChanged();
    }

    // ── Accounts Dialog ───────────────────────────────────────────────────────

    void OpenAccountsDialog() { ResetAccForm(); _accDlgOpen = true; }

    void ResetAccForm()
    {
        _editAccId = null; _accName = ""; _accEmail = ""; _accApiKey = "";
        _accColor = AvailableColors[0];
    }

    void EditAccount(AccountProfile acc)
    {
        _editAccId = acc.Id; _accName = acc.Name; _accEmail = acc.Email;
        _accApiKey = acc.ApiKey; _accColor = acc.Color;
    }

    async Task SaveAccount()
    {
        if (string.IsNullOrWhiteSpace(_accName) || string.IsNullOrWhiteSpace(_accApiKey)) return;
        var profile = new AccountProfile { Id = _editAccId ?? "", Name = _accName, Email = _accEmail, ApiKey = _accApiKey, Color = _accColor };
        if (_editAccId == null)
        {
            await AccountSvc.AddAsync(profile);
            Snackbar.Add("اکانت جدید اضافه شد", Severity.Success);
        }
        else
        {
            await AccountSvc.UpdateAsync(profile);
            Snackbar.Add("اطلاعات اکانت بروزرسانی شد", Severity.Success);
        }
        ResetAccForm(); StateHasChanged();
        _ = RefreshSessionsInBackground();
    }

    async Task DeleteAccount(string id)
    {
        if (await AccountSvc.DeleteAsync(id))
        {
            Snackbar.Add("اکانت حذف شد", Severity.Info);
            _sessions.RemoveAll(s => s.AccountId == id);
            if (_sel?.AccountId == id) _sel = null;
            StateHasChanged();
        }
    }

    async Task RefreshSessionsInBackground()
    {
        try
        {
            var combined = await FetchAllSessionsAsync();
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                _sessions = combined;
                if (_sel != null) _sel = _sessions.FirstOrDefault(s => s.Id == _sel.Id) ?? _sel;
                StateHasChanged();
            });
        }
        catch (Exception ex) { Console.WriteLine($"BgRefresh: {ex.Message}"); }
    }

    // ── Render Helpers ────────────────────────────────────────────────────────

    RenderFragment RenderGroup(string label, string dotKey, IEnumerable<Session> items) => __builder =>
    {
        var list = items.ToList();
        if (!list.Any()) return;

        <div class="jp-group-header">
            <span class="jp-group-dot jp-group-dot--@dotKey"></span>
            @label
            <span class="jp-group-count">@list.Count</span>
        </div>
        @foreach (var s in list)
        {
            <div class="jp-sess-card @(s.Id == _sel?.Id ? "jp-sess-card--active" : "")" @onclick="() => Pick(s)">
                <div class="jp-sess-row">
                    @if (!string.IsNullOrEmpty(s.AccountColor))
                    {
                        <span class="jp-acc-badge" style="background:@s.AccountColor" title="@s.AccountName">@GetInitials(s.AccountName)</span>
                    }
                    <span class="jp-sess-name">@s.DisplayTitle</span>
                </div>
                <div class="jp-sess-meta">
                    <span class="jp-status-badge jp-status-badge--@s.StatusBadgeClass">@s.PersianStatusLabel</span>
                    <span class="jp-sess-time">@s.FormattedTimeShort</span>
                </div>
            </div>
        }
    };

    RenderFragment RenderWorkflowColumn(string key, string title, string icon, string colorClass, IEnumerable<Session> sessions) => __builder =>
    {
        var list = sessions.ToList();
        <div class="jp-kb-col @colorClass">
            <div class="jp-kb-col-head">
                <div class="jp-kb-col-title-wrap">
                    <span class="jp-kb-col-icon">@icon</span>
                    <span class="jp-kb-col-title">@title</span>
                </div>
                <span class="jp-kb-col-badge">@list.Count</span>
            </div>
            <div class="jp-kb-col-cards">
                @if (!list.Any())
                {
                    <div class="jp-kb-col-empty">
                        <span>خالی</span>
                    </div>
                }
                else
                {
                    @foreach (var session in list)
                    {
                        @RenderModernCard(session, showAccount: true)
                    }
                }
            </div>
        </div>
    };

    RenderFragment RenderModernCard(Session session, bool showAccount) => __builder =>
    {
        <div class="jp-kb-card @(session.NeedsPlanApproval ? "jp-kb-card--needs-approval" : "")" @onclick="() => Pick(session)">
            
            <!-- Card Header: Account + Repo + Short ID -->
            <div class="jp-kb-card-top">
                <div class="jp-kb-card-meta-left">
                    @if (showAccount && !string.IsNullOrEmpty(session.AccountName))
                    {
                        <span class="jp-acc-chip" style="background: @(session.AccountColor)20; color: @(session.AccountColor); border-color: @(session.AccountColor)40;">
                            <span class="jp-acc-dot" style="background: @session.AccountColor"></span>
                            @session.AccountName
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(session.RepositoryDisplay))
                    {
                        <span class="jp-kb-repo-pill" title="@session.RepositoryDisplay">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                            @session.RepositoryDisplay
                        </span>
                    }
                </div>
                <span class="jp-kb-card-id">#@session.ShortId</span>
            </div>

            <!-- Card Title -->
            <h4 class="jp-kb-card-title">@session.DisplayTitle</h4>

            <!-- Card Prompt Snippet -->
            @if (!string.IsNullOrWhiteSpace(session.CleanPrompt) && session.CleanPrompt != session.Title)
            {
                <p class="jp-kb-card-prompt">@session.CleanPrompt</p>
            }

            <!-- Direct Plan Approval Call-to-action if waiting -->
            @if (session.NeedsPlanApproval)
            {
                <div class="jp-kb-card-cta" @onclick:stopPropagation>
                    <button class="jp-btn jp-btn--warn jp-btn--xs" @onclick="() => ApproveSessionDirect(session)">
                        ⚡ تأیید و اجرای مستقیم برنامه
                    </button>
                </div>
            }

            <!-- Card Footer: Time + Status Badge -->
            <div class="jp-kb-card-footer">
                <span class="jp-kb-card-time">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    @session.FormattedTime
                </span>
                <span class="jp-status-badge jp-status-badge--@session.StatusBadgeClass">@session.PersianStatusLabel</span>
            </div>

        </div>
    };

    string GetInitials(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?"
        : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();

    string BadgeKey(string? st)
    {
        if (st == null) return "idle";
        var u = st.ToUpper();
        if (IsWorking(st)) return "working";
        if (IsDone(st))    return "done";
        if (IsArchived(st)) return "archived";
        if (u.Contains("ERROR") || u.Contains("FAIL")) return "error";
        return "idle";
    }

    IEnumerable<Session> WorkingSessions  => _sessions.Where(s => s.IsWorking && !s.NeedsPlanApproval);
    IEnumerable<Session> AwaitingApprovalSessions => _sessions.Where(s => s.NeedsPlanApproval);
    IEnumerable<Session> DoneSessions     => _sessions.Where(s => s.IsCompleted);
    IEnumerable<Session> PausedSessions   => _sessions.Where(s => s.IsPaused || s.IsArchived);
    IEnumerable<Session> OtherSessions    => _sessions.Where(s => !s.IsWorking && !s.NeedsPlanApproval && !s.IsCompleted && !s.IsPaused && !s.IsArchived);

    bool IsWorking(string? st)
    {
        if (st == null) return false;
        var u = st.ToUpper();
        return u is "IN_PROGRESS" or "PLANNING" or "QUEUED"
            || u.Contains("WORKING") || u.Contains("RUNNING");
    }
    bool IsDone(string? st) { if (st == null) return false; var u = st.ToUpper(); return u is "COMPLETED" or "DONE" or "FINISHED" || u.Contains("COMPLET"); }
    bool IsArchived(string? st) { if (st == null) return false; return st.ToUpper().Contains("ARCHIVED") || st.ToUpper() == "PAUSED"; }
}

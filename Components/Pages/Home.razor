@page "/"
@inject JulesApiService JulesApi
@inject AccountService AccountSvc
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Jules Panel</PageTitle>

<div class="jp-layout">

    <!-- ══════════ SIDEBAR ══════════ -->
    <div class="jp-sidebar">

        <!-- Sidebar Header -->
        <div class="jp-sidebar-head">
            <div class="jp-sidebar-head-top">
                <span class="jp-sidebar-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
                    جلسات
                </span>
                <div class="jp-view-toggle" role="group" aria-label="انتخاب نمای اصلی">
                    <button class="jp-view-toggle-btn @(_mainViewMode == MainViewMode.List ? "jp-view-toggle-btn--active" : "")"
                            title="نمای لیستی و چت"
                            aria-pressed="@(_mainViewMode == MainViewMode.List)"
                            @onclick="() => SetMainView(MainViewMode.List)">
                        📋
                    </button>
                    <button class="jp-view-toggle-btn @(_mainViewMode == MainViewMode.Kanban ? "jp-view-toggle-btn--active" : "")"
                            title="تخته کانبان جلسات"
                            aria-pressed="@(_mainViewMode == MainViewMode.Kanban)"
                            @onclick="() => SetMainView(MainViewMode.Kanban)">
                        📊
                    </button>
                </div>
            </div>
            <div class="jp-sidebar-head-actions">
                <button class="jp-icon-btn" title="تغییر پوسته" @onclick="ToggleTheme">
                    @if (_isLightMode)
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    }
                </button>
                <button class="jp-icon-btn" title="مدیریت اکانت‌ها" @onclick="OpenAccountsDialog">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </button>
                <button class="jp-icon-btn" title="بارگذاری مجدد" @onclick="LoadSessions">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                </button>
                <button class="jp-btn jp-btn--primary" style="flex:1; font-size:0.75rem; height:28px;" @onclick="OpenCreateDialog">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    &nbsp;سشن جدید
                </button>
            </div>
        </div>

        <!-- Session List -->
        <div class="jp-session-list">
            @if (_loadSess)
            {
                <div class="jp-state-center"><div class="jp-spin"></div></div>
            }
            else if (!_sessions.Any())
            {
                <div class="jp-empty-state">هیچ جلسه‌ای یافت نشد</div>
            }
            else
            {
                @RenderGroup("در حال کار", "working", WorkingSessions)
                @RenderGroup("منتظر تأیید", "warning", AwaitingApprovalSessions)
                @RenderGroup("کامل‌شده", "done", DoneSessions)
                @RenderGroup("متوقف / آرشیو", "archived", PausedSessions)
                @RenderGroup("سایر", "other", OtherSessions)
            }
        </div>

        <!-- Account Stats Footer -->
        @if (AccountSvc.GetAll().Count > 0)
        {
            <div class="jp-acc-stats">
                @foreach (var acc in AccountSvc.GetAll())
                {
                    var cnt = _sessions.Count(s => s.AccountId == acc.Id);
                    <div class="jp-acc-stat-row">
                        <span class="jp-acc-pip" style="background:@acc.Color"></span>
                        <span class="jp-acc-stat-name">@acc.Name</span>
                        <span class="jp-acc-stat-val">@cnt جلسه</span>
                    </div>
                }
            </div>
        }

    </div>

    <!-- ══════════ MAIN PANEL ══════════ -->
    <div class="jp-main">

        @if (_mainViewMode == MainViewMode.Kanban)
        {
            <section class="jp-kanban-wrapper" aria-label="تخته کانبان جلسات">
                
                <!-- Modern Kanban Header & Toolbar -->
                <div class="jp-kb-toolbar">
                    <div class="jp-kb-toolbar-right">
                        <div class="jp-kb-title-box">
                            <span class="jp-kb-main-icon">📊</span>
                            <div class="jp-kb-title-texts">
                                <h1 class="jp-kb-heading">تخته کانبان جلسات Jules</h1>
                                <span class="jp-kb-subtitle">@FilteredSessions.Count() جلسه @(string.IsNullOrWhiteSpace(_searchQuery) && string.IsNullOrEmpty(_filterAccountId) ? "موجود" : "مطابق با فیلتر")</span>
                            </div>
                        </div>

                        <!-- Sub-view switcher -->
                        <div class="jp-kb-nav-tabs">
                            <button class="jp-kb-nav-tab @(_kanbanMode == KanbanViewMode.Status ? "jp-kb-nav-tab--active" : "")"
                                    @onclick="() => _kanbanMode = KanbanViewMode.Status">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                                <span>گردش وضعیت‌ها</span>
                            </button>
                            <button class="jp-kb-nav-tab @(_kanbanMode == KanbanViewMode.AccountSwimlanes ? "jp-kb-nav-tab--active" : "")"
                                    @onclick="() => _kanbanMode = KanbanViewMode.AccountSwimlanes">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                <span>تفکیک کاربران</span>
                            </button>
                            <button class="jp-kb-nav-tab @(_kanbanMode == KanbanViewMode.SimpleCards ? "jp-kb-nav-tab--active" : "")"
                                    @onclick="() => _kanbanMode = KanbanViewMode.SimpleCards">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                                <span>کارت‌های گرید</span>
                            </button>
                        </div>
                    </div>

                    <!-- Search, Filters and Create button -->
                    <div class="jp-kb-toolbar-left">
                        <div class="jp-kb-search-box">
                            <svg class="jp-kb-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <input class="jp-kb-search-input" 
                                   type="text" 
                                   placeholder="جستجو در جلسات..." 
                                   @bind="_searchQuery" 
                                   @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_searchQuery))
                            {
                                <button class="jp-kb-search-clear" @onclick="() => _searchQuery = string.Empty">✕</button>
                            }
                        </div>

                        @if (AccountSvc.GetAll().Count > 1)
                        {
                            <select class="jp-kb-filter-select" @bind="_filterAccountId">
                                <option value="">همه کاربران</option>
                                @foreach (var acc in AccountSvc.GetAll())
                                {
                                    <option value="@acc.Id">@acc.Name</option>
                                }
                            </select>
                        }

                        <button class="jp-btn jp-btn--primary jp-btn--sm" @onclick="OpenCreateDialog">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            <span>جلسه جدید</span>
                        </button>
                    </div>
                </div>

                <!-- Kanban Board Body -->
                <div class="jp-kb-board-container">
                    @if (_loadSess)
                    {
                        <div class="jp-state-center" style="height: 400px;"><div class="jp-spin"></div><span class="jp-state-label">در حال بارگذاری جلسات...</span></div>
                    }
                    else if (!FilteredSessions.Any())
                    {
                        <div class="jp-kb-empty-board">
                            <div class="jp-kb-empty-icon">📭</div>
                            <h3>جلسه‌ای یافت نشد</h3>
                            <p>هیچ جلسه‌ای مطابق با جستجو یا فیلتر فعلی شما پیدا نشد.</p>
                            @if (!string.IsNullOrEmpty(_searchQuery) || !string.IsNullOrEmpty(_filterAccountId))
                            {
                                <button class="jp-btn jp-btn--ghost jp-btn--sm" @onclick="ClearFilters">پاک کردن فیلترها</button>
                            }
                        </div>
                    }
                    else
                    {
                        @switch (_kanbanMode)
                        {
                            case KanbanViewMode.Status:
                                <!-- 5 Clean, Standard Workflow Columns -->
                                <div class="jp-kb-columns-row">
                                    @RenderWorkflowColumn("WORKING", "در حال اجرا و برنامه‌ریزی", "⚡", "col--working", FilteredSessions.Where(s => s.IsWorking && !s.NeedsPlanApproval))
                                    @RenderWorkflowColumn("AWAITING", "منتظر تأیید شما", "⚠️", "col--awaiting", FilteredSessions.Where(s => s.NeedsPlanApproval))
                                    @RenderWorkflowColumn("PAUSED", "متوقف شده", "⏸️", "col--paused", FilteredSessions.Where(s => s.IsPaused))
                                    @RenderWorkflowColumn("COMPLETED", "تکمیل شده", "✅", "col--completed", FilteredSessions.Where(s => s.IsCompleted))
                                    @RenderWorkflowColumn("FAILED", "خطا / لغو", "❌", "col--failed", FilteredSessions.Where(s => s.IsFailed))
                                </div>
                                break;

                            case KanbanViewMode.AccountSwimlanes:
                                <!-- Clean Account-grouped Sections (No empty matrix cells!) -->
                                <div class="jp-swimlane-list">
                                    @foreach (var acc in ActiveAccountsInView)
                                    {
                                        var accSessions = FilteredSessions.Where(s => s.AccountId == acc.Id).ToList();
                                        var accWorking = accSessions.Count(s => s.IsWorking);
                                        var accAwaiting = accSessions.Count(s => s.NeedsPlanApproval);
                                        var accCompleted = accSessions.Count(s => s.IsCompleted);

                                        <div class="jp-swimlane-section">
                                            <div class="jp-swimlane-header" style="border-right-color: @acc.Color;">
                                                <div class="jp-swimlane-user">
                                                    <span class="jp-acc-avatar" style="background:@acc.Color">@acc.Initials</span>
                                                    <div>
                                                        <div class="jp-swimlane-name">@acc.Name</div>
                                                        <div class="jp-swimlane-email">@acc.Email</div>
                                                    </div>
                                                </div>
                                                <div class="jp-swimlane-stats">
                                                    <span class="jp-swimlane-pill" title="کل جلسات">@accSessions.Count جلسه</span>
                                                    @if (accAwaiting > 0)
                                                    {
                                                        <span class="jp-swimlane-pill jp-swimlane-pill--warn">⚠️ @accAwaiting منتظر تأیید</span>
                                                    }
                                                    @if (accWorking > 0)
                                                    {
                                                        <span class="jp-swimlane-pill jp-swimlane-pill--work">⚡ @accWorking فعال</span>
                                                    }
                                                    <span class="jp-swimlane-pill jp-swimlane-pill--done">✅ @accCompleted تکمیل</span>
                                                </div>
                                            </div>
                                            <div class="jp-swimlane-cards-grid">
                                                @foreach (var session in accSessions)
                                                {
                                                    @RenderModernCard(session, showAccount: false)
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                break;

                            case KanbanViewMode.SimpleCards:
                                <!-- Compact Responsive Grid -->
                                <div class="jp-compact-grid">
                                    @foreach (var session in FilteredSessions)
                                    {
                                        @RenderModernCard(session, showAccount: true)
                                    }
                                </div>
                                break;
                        }
                    }
                </div>
            </section>
        }
        else if (_sel == null)
        {
            <div class="jp-welcome">
                <div class="jp-welcome-glyph">⚡</div>
                <h2 class="jp-welcome-heading">پنل مدیریت هوشمند Jules</h2>
                <p class="jp-welcome-sub">یک جلسه را از سایدبار انتخاب کنید، نمای کانبان را باز کنید یا یک جلسه جدید بسازید.</p>
                <div class="jp-welcome-actions">
                    <button class="jp-btn jp-btn--primary" @onclick="OpenCreateDialog">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        جلسه جدید
                    </button>
                    <button class="jp-btn jp-btn--ghost" @onclick="() => SetMainView(MainViewMode.Kanban)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                        مشاهده تخته کانبان
                    </button>
                    <button class="jp-btn jp-btn--ghost" @onclick="OpenAccountsDialog">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        مدیریت اکانت‌ها
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Title Bar -->
            <div class="jp-titlebar">
                <div class="jp-titlebar-left">
                    @if (!string.IsNullOrEmpty(_sel.AccountColor))
                    {
                        <span class="jp-acc-badge" style="background:@_sel.AccountColor" title="@_sel.AccountName">
                            @GetInitials(_sel.AccountName)
                        </span>
                    }
                    <span class="jp-titlebar-name">@_sel.DisplayTitle</span>
                    <span class="jp-status-badge jp-status-badge--@_sel.StatusBadgeClass">@_sel.PersianStatusLabel</span>
                    @if (!string.IsNullOrEmpty(_sel.RepositoryDisplay))
                    {
                        <span class="jp-repo-tag" title="مخزن و شاخه">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                            @_sel.RepositoryDisplay @(!string.IsNullOrEmpty(_sel.BranchDisplay) ? $": {_sel.BranchDisplay}" : "")
                        </span>
                    }
                </div>
                <div class="jp-titlebar-right">
                    @if (_sel.NeedsPlanApproval)
                    {
                        <button class="jp-btn jp-btn--warn jp-btn--sm" @onclick="Approve">
                            ⚡ تأیید برنامه
                        </button>
                    }
                    <button class="jp-icon-btn jp-icon-btn--danger" title="حذف جلسه" @onclick="OpenDeleteConfirm">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </button>
                    <button class="jp-icon-btn" title="بروزرسانی" @onclick="Refresh">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                    </button>
                </div>
            </div>

            <!-- Tabs -->
            <div class="jp-tabs">
                <button class="jp-tab @(_tab == 0 ? "jp-tab--active" : "")" @onclick="() => _tab = 0">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                    فعالیت‌ها و گفتگو
                    @if (_activities.Count > 0) { <span class="jp-tab-pill">@_activities.Count</span> }
                </button>
                <button class="jp-tab @(_tab == 1 ? "jp-tab--active" : "")" @onclick="() => _tab = 1">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    برنامه کاری (Plan)
                    @if (_plan?.Steps.Count > 0) { <span class="jp-tab-pill">@_plan.Steps.Count</span> }
                    @if (_sel.NeedsPlanApproval) { <span class="jp-tab-dot"></span> }
                </button>
            </div>

            <!-- Tab Content -->
            <div class="jp-content">

                @if (_tab == 0)
                {
                    @if (_loadAct)
                    {
                        <div class="jp-state-center"><div class="jp-spin"></div><span class="jp-state-label">دریافت فعالیت‌ها...</span></div>
                    }
                    else if (!_activities.Any(a => a.HasContent))
                    {
                        <div class="jp-empty-state">هنوز فعالیتی ثبت نشده است.</div>
                    }
                    else
                    {
                        <div class="jp-feed">
                            @if (!string.IsNullOrWhiteSpace(_sel.Prompt))
                            {
                                <div class="jp-bubble jp-bubble--user">
                                    <div class="jp-bubble-header">
                                        <span class="jp-bubble-who jp-bubble-who--user">👤 شما</span>
                                        <span class="jp-bubble-ts">دستور اولیه</span>
                                    </div>
                                    <div class="jp-bubble-body">@_sel.Prompt</div>
                                </div>
                            }
                            @foreach (var act in _activities.Where(a => a.HasContent))
                            {
                                <div class="jp-bubble @(act.IsAgent ? "jp-bubble--agent" : "jp-bubble--user")">
                                    <div class="jp-bubble-header">
                                        <span class="jp-bubble-who @(act.IsAgent ? "jp-bubble-who--agent" : "jp-bubble-who--user")">
                                            @(act.IsAgent ? "🤖 Jules" : "👤 شما")
                                        </span>
                                        <span class="jp-bubble-ts">@(act.CreateTime?.ToLocalTime().ToString("HH:mm:ss"))</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(act.Text))
                                    {
                                        <div class="jp-bubble-body">@act.Text</div>
                                    }
                                    @if (act.Plan != null)
                                    {
                                        <div class="jp-bubble-body jp-bubble-plan-ref">
                                            📌 برنامه پیشنهادی جدید: <strong>@act.Plan.Title</strong> — @act.Plan.Steps.Count گام
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }

                @if (_tab == 1)
                {
                    @if (_plan == null)
                    {
                        <div class="jp-empty-state">برنامه‌ای برای این جلسه ثبت نشده است.</div>
                    }
                    else
                    {
                        <div class="jp-plan-panel">
                            @if (!string.IsNullOrWhiteSpace(_plan.Title))
                            {
                                <h3 class="jp-plan-title">@_plan.Title</h3>
                            }
                            @if (!string.IsNullOrWhiteSpace(_plan.Description))
                            {
                                <p class="jp-plan-desc">@_plan.Description</p>
                            }
                            @if (_sel.NeedsPlanApproval)
                            {
                                <div class="jp-approve-banner">
                                    <span>⚠️ برنامه منتظر تأیید شماست تا مراحل زیر اجرا شود.</span>
                                    <button class="jp-btn jp-btn--warn jp-btn--sm" @onclick="Approve">تأیید و اجرا</button>
                                </div>
                            }
                            <div class="jp-steps">
                                @for (int i = 0; i < _plan.Steps.Count; i++)
                                {
                                    var st = _plan.Steps[i];
                                    <div class="jp-step">
                                        <div class="jp-step-num">@(i + 1)</div>
                                        <div class="jp-step-body">
                                            <div class="jp-step-title">@st.Title</div>
                                            @if (!string.IsNullOrWhiteSpace(st.Description))
                                            {
                                                <div class="jp-step-desc">@st.Description</div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(st.State))
                                        {
                                            <span class="jp-status-badge jp-status-badge--@BadgeKey(st.State)">@st.State</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

            </div>

            <!-- Input Bar -->
            <div class="jp-inputbar">
                <textarea class="jp-inputbar-textarea"
                          rows="2"
                          placeholder="دستور جدید برای Jules... (Ctrl+Enter برای ارسال)"
                          @bind="_prompt"
                          @bind:event="oninput"
                          @onkeydown="OnPromptKeyDown"></textarea>
                <button class="jp-btn jp-btn--send" disabled="@(_sending || string.IsNullOrWhiteSpace(_prompt))" @onclick="Send">
                    @if (_sending)
                    {
                        <div class="jp-spin jp-spin--sm"></div>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    }
                </button>
            </div>
        }

    </div>
</div>

<!-- ══════════ DELETE SESSION CONFIRM DIALOG ══════════ -->
@if (_deleteDlgOpen && _sel != null)
{
    <div class="jp-backdrop" @onclick="() => _deleteDlgOpen = false">
        <div class="jp-modal" style="max-width: 420px;" @onclick:stopPropagation>
            <div class="jp-modal-head">
                <span class="jp-modal-title" style="color: var(--red);">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    حذف جلسه
                </span>
                <button class="jp-modal-close" @onclick="() => _deleteDlgOpen = false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="jp-modal-body">
                <p style="margin: 0 0 12px 0; font-size: 0.9rem; color: var(--tx);">آیا از حذف این جلسه اطمینان دارید؟</p>
                <div style="background: var(--bg-hover); padding: 10px 14px; border-radius: var(--r-sm); border: 1px solid var(--bd); margin-bottom: 16px;">
                    <div style="font-weight: 700; font-size: 0.9rem; color: var(--tx);">@_sel.DisplayTitle</div>
                    <div style="font-size: 0.78rem; color: var(--tx-muted); margin-top: 4px;">شناسه: @_sel.Id</div>
                </div>
                <p style="font-size: 0.8rem; color: var(--red); margin: 0;">⚠️ این عملیات غیرقابل بازگشت است.</p>
